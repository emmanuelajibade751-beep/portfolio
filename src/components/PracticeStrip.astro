---
/**
 * The landing page's breadth signal: four text-only tiles, one per practice
 * area, each linking to its section. Text-only (no images) is deliberate —
 * it's the fastest way to say "this practice spans four disciplines" without
 * waiting on hero imagery, and it keeps the strip light. Hover borrows the
 * card's lift + orange border so it reads as part of the same system.
 */
import { withBase } from "../lib/base";

interface Tile {
  name: string;
  href: string;
  blurb: string;
}

// Order mirrors the nav: Design → Structure → Research → AI.
const tiles: Tile[] = [
  { name: "Design", href: "/design/", blurb: "Computational + architectural design" },
  { name: "Structure", href: "/structural/", blurb: "Connections, details, buildability" },
  { name: "Research", href: "/research/", blurb: "Urban studies, publications" },
  { name: "AI & Tools", href: "/ai/", blurb: "Vibe coding, plugins, workflows" },
];
---

<section class="practice" aria-label="Practice areas">
  <ul class="practice__grid">
    {
      tiles.map((tile) => (
        <li>
          <a class="practice__tile" href={withBase(tile.href)}>
            <span class="practice__name">{tile.name}</span>
            <span class="practice__blurb">{tile.blurb}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .practice {
    max-width: 1100px;
    margin: 5rem auto;
    padding: 0 1.5rem;
  }

  .practice__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .practice__tile {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-grid-line);
    background: #ffffff;
    padding: 1.5rem 1.4rem;
    transition:
      transform 0.35s cubic-bezier(0.34, 1.3, 0.64, 1),
      border-color 0.35s ease;
  }

  .practice__tile:hover,
  .practice__tile:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .practice__name {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }

  .practice__blurb {
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--color-fg);
  }

  @media (prefers-reduced-motion: reduce) {
    .practice__tile {
      transition: none;
    }
  }
</style>

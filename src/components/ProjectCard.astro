---
/**
 * A single project card — the shared visual behind both SectionGrid and
 * FeaturedWork. Extracted from the old WorkCatalogue so the card design
 * (border, cover, meta, hover lift) lives in exactly one place; the two
 * grids differ only in which projects they select and where cards link.
 *
 * Renders as an <li> so a parent <ul class="grid"> can lay it out directly.
 */
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  href: string; // full route to the detail page, e.g. "/design/facade-study/"
  cover: ImageMetadata; // resolved cover image from the collection entry
  title: string;
  description: string;
  tags: string[];
}

const { href, cover, title, description, tags } = Astro.props;
---

<li class="card-item">
  <a class="card" href={href}>
    <Image
      class="card__cover"
      src={cover}
      alt={`Cover image for ${title}`}
      width={1200}
      height={800}
      loading="lazy"
    />
    <div class="card__meta">
      <h3 class="card__name">{title}</h3>
      <p class="card__desc">{description}</p>
      {
        tags.length > 0 && (
          <p class="card__tags">
            {tags.map((tag) => (
              <span class="card__tag">{tag}</span>
            ))}
          </p>
        )
      }
    </div>
  </a>
</li>

<style>
  .card-item {
    /* The parent <ul class="grid"> handles placement; nothing needed here. */
    display: block;
  }

  .card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-grid-line);
    background: #ffffff;
    /* The house motion curve, approximated as cubic-bezier — subtle lift. */
    transition:
      transform 0.35s cubic-bezier(0.34, 1.3, 0.64, 1),
      border-color 0.35s ease;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .card__cover {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--color-grid-line);
  }

  .card__meta {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .card__name {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .card__desc {
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .card__tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-grid-line);
    color: var(--color-ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }
  }
</style>

---
/**
 * A discipline-filtered project grid. Replaces the old WorkCatalogue:
 * instead of showing every project, it takes a `discipline` and a
 * `basePath`, selects the matching entries, sorts them (explicit `order`
 * first, then newest date), and renders shared ProjectCards that link
 * under the section route.
 *
 * Used by /design, /structural and /ai — one component, three sections.
 */
import { getCollection } from "astro:content";
import ProjectCard from "./ProjectCard.astro";
import { withBase } from "../lib/base";

interface Props {
  discipline: "design" | "structural" | "ai";
  basePath: string; // route prefix for card links, e.g. "/design"
  emptyMessage?: string; // shown when no projects match yet
}

const {
  discipline,
  basePath,
  emptyMessage = "No projects here yet — check back soon.",
} = Astro.props;

// Filter to this discipline, then apply the catalogue's sort convention:
// ordered entries ascending, unordered ones after, newest date breaking ties.
const projects = (await getCollection("projects"))
  .filter((project) => project.data.discipline === discipline)
  .sort(
    (a, b) =>
      (a.data.order ?? 99) - (b.data.order ?? 99) ||
      b.data.date.valueOf() - a.data.date.valueOf()
  );

// Normalise the base path so "/design" and "/design/" both yield clean links.
const base: string = basePath.replace(/\/$/, "");
---

{
  projects.length > 0 ? (
    <ul class="grid">
      {projects.map((project) => (
        <ProjectCard
          href={withBase(`${base}/${project.id}/`)}
          cover={project.data.cover}
          title={project.data.title}
          description={project.data.description}
          tags={project.data.tags}
        />
      ))}
    </ul>
  ) : (
    <p class="grid__empty">{emptyMessage}</p>
  )
}

<style>
  .grid {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .grid__empty {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--color-ink-soft);
  }
</style>

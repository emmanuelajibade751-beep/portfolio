---
/**
 * Quiet typographic nav: mono wordmark + three links. Black on white,
 * orange reserved for hover/active.
 */
---

<header class="nav">
  <a class="nav__mark" href="/">
    <svg viewBox="0 0 100 100" width="18" height="18" aria-hidden="true">
      <path
        d="M50 5 L60 40 L95 50 L60 60 L50 95 L40 60 L5 50 L40 40 Z"
        fill="currentColor"
      />
    </svg>
    <!-- Owner-editable: name + practice line -->
    <span>Sunday Emmanuel Ajibade</span>
  </a>
  <nav class="nav__links" aria-label="Site">
    <a href="/#work">Work</a>
    <a href="/#about">About</a>
    <a href="/#contact">Contact</a>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.4rem 1.5rem;
  }

  .nav__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-fg);
  }

  .nav__mark svg {
    color: var(--color-accent);
  }

  .nav__links {
    display: flex;
    gap: 1.6rem;
  }

  .nav__links a {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink-soft);
    transition: color 0.25s ease;
  }

  .nav__links a:hover,
  .nav__links a:focus-visible {
    color: var(--color-accent-deep);
  }
</style>

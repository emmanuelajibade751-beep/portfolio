---
/**
 * The project catalogue grid. Entries come entirely from
 * src/content/projects/ (see content.config.ts) — the owner adds work by
 * dropping a .md + cover image there; this component never changes.
 */
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

const projects = (await getCollection("projects")).sort(
  (a, b) =>
    (a.data.order ?? 99) - (b.data.order ?? 99) ||
    b.data.date.valueOf() - a.data.date.valueOf()
);
---

<section class="work" id="work">
  <div class="work__head">
    <p class="work__eyebrow">Selected Work</p>
    <h2 class="work__title">Projects</h2>
  </div>

  <ul class="work__grid">
    {
      projects.map((project) => (
        <li class="work__item">
          <a class="work__card" href={`/work/${project.id}/`}>
            <Image
              class="work__cover"
              src={project.data.cover}
              alt={`Cover image for ${project.data.title}`}
              width={1200}
              height={800}
              loading="lazy"
            />
            <div class="work__meta">
              <h3 class="work__name">{project.data.title}</h3>
              <p class="work__desc">{project.data.description}</p>
              <p class="work__tags">
                {project.data.tags.map((tag) => (
                  <span class="work__tag">{tag}</span>
                ))}
              </p>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .work {
    max-width: 1100px;
    margin: 7rem auto;
    padding: 0 1.5rem;
  }

  .work__eyebrow {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
  }

  .work__title {
    margin: 0 0 2.5rem;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .work__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .work__card {
    display: block;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-grid-line);
    background: #ffffff;
    /* The house motion curve, approximated as cubic-bezier — subtle lift. */
    transition:
      transform 0.35s cubic-bezier(0.34, 1.3, 0.64, 1),
      border-color 0.35s ease;
  }

  .work__card:hover,
  .work__card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .work__cover {
    display: block;
    width: 100%;
    height: auto;
    border-bottom: 1px solid var(--color-grid-line);
  }

  .work__meta {
    padding: 1.1rem 1.2rem 1.3rem;
  }

  .work__name {
    margin: 0 0 0.4rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .work__desc {
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-ink-soft);
  }

  .work__tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .work__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-grid-line);
    color: var(--color-ink-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .work__card {
      transition: none;
    }
  }
</style>

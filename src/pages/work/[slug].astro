---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const dateLabel = project.data.date.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
});
---

<Base
  title={`${project.data.title} — Sunday Emmanuel Ajibade`}
  description={project.data.description}
>
  <article class="project">
      <a class="project__back" href="/#work">&larr; All projects</a>

      <header class="project__head">
        <h1 class="project__title">{project.data.title}</h1>
        <p class="project__meta">
          <span>{dateLabel}</span>
          {project.data.tools.length > 0 && <span> · {project.data.tools.join(" / ")}</span>}
        </p>
        <p class="project__tags">
          {project.data.tags.map((tag) => <span class="project__tag">{tag}</span>)}
        </p>
      </header>

      <Image
        class="project__cover"
        src={project.data.cover}
        alt={`Cover image for ${project.data.title}`}
        width={1200}
        height={800}
      />

      <div class="project__body">
        <Content />
      </div>
    </article>
</Base>

<style>
  .project {
    max-width: 760px;
    margin: 4rem auto 6rem;
    padding: 0 1.5rem;
  }

  .project__back {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    text-decoration: none;
  }

  .project__back:hover {
    text-decoration: underline;
  }

  .project__head {
    margin: 2rem 0;
  }

  .project__title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .project__meta {
    margin: 0 0 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-ink-soft);
  }

  .project__tags {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project__tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-grid-line);
    color: var(--color-ink-soft);
  }

  .project__cover {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-grid-line);
    margin: 0 0 2.5rem;
  }

  .project__body {
    font-size: 1.02rem;
    line-height: 1.7;
  }

  .project__body :global(img) {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--color-grid-line);
  }

  .project__body :global(h2) {
    margin-top: 2.2rem;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }
</style>
